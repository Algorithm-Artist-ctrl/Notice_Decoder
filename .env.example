# =================================================================
# Notice Decoder — Environment Variables Configuration Template
# =================================================================
# NOTE: Copy this file to .env or .env.local and populate with your own
# values. Never commit actual secret values or credentials to Git.
# =================================================================

# Server Listening Port (Default: 3000)
PORT=3000

# Client Application URL (Configures CORS and Auth Origin headers)
CLIENT_URL=http://localhost:5173

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# -----------------------------------------------------------------
# Database Configuration (Neon Serverless PostgreSQL)
# -----------------------------------------------------------------
# Pooled PostgreSQL connection string with SSL required.
# Retrieve from your Neon Project Dashboard: https://console.neon.tech
DATABASE_URL=postgresql://<username>:<password>@<ep-pooler-host>.neon.tech/<database_name>?sslmode=require

# -----------------------------------------------------------------
# AI / LLM Configuration (Google Gemini API)
# -----------------------------------------------------------------
# Google AI Studio API Key for multimodal extraction and multilingual translation.
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (Default: gemini-3.8-flash; fallback: gemini-2.0-flash)
GEMINI_MODEL=gemini-3.8-flash

# Default Application Timezone for date parsing and iCalendar export
DEFAULT_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------
# Optional: Neon Managed Auth & S3 Object Storage
# -----------------------------------------------------------------
# NEON_AUTH_BASE_URL=https://<neon-auth-host>/neondb/auth
# AWS_ENDPOINT_URL_S3=https://<region>.storage.neon.tech
# AWS_ACCESS_KEY_ID=your_neon_storage_access_key
# AWS_SECRET_ACCESS_KEY=your_neon_storage_secret_key
# AWS_REGION=ap-southeast-1
