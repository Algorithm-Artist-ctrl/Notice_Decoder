# =================================================================
# Notice Decoder — Environment Variables Configuration
# =================================================================
# NOTE: Copy this file to .env and replace placeholder values.
# NEVER commit real credentials to version control.
# =================================================================

# Server Port
PORT=3000

# Client App URL (for CORS)
CLIENT_URL=http://localhost:5173

# Neon Serverless PostgreSQL Connection String
# Get this from your Neon console: https://console.neon.tech
# If not provided, the application automatically uses the resilient local fallback store.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/notice_decoder?sslmode=require

# Google Gemini API Key for AI-assisted entity extraction
# Get an API key from Google AI Studio: https://aistudio.google.com/
# If not provided, Notice Decoder automatically uses its deterministic heuristic parser.
GEMINI_API_KEY=your_gemini_api_key_here

# Default Application Timezone
DEFAULT_TIMEZONE=Asia/Kolkata

# Node Environment
NODE_ENV=development
